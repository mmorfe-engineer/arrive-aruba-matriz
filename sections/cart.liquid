<section class="main-cart section-space" data-section-id="{{ section.id }}">
  <div class="page-width">
    <header class="section-header"><div><p class="eyebrow">Arrive Aruba</p><h1 class="serif-heading">{{ 'cart.title' | t }}</h1></div></header>
    {% if cart.empty? %}<div class="empty-state"><p class="serif-heading">{{ 'cart.empty' | t }}</p><a class="button button--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a></div>{% else %}
      <div class="cart-page-lines">{% for item in cart.items %}<article class="cart-line">{% if item.image %}{{ item.image | image_url: width: 320 | image_tag: class: 'cart-line-media', widths: '160, 240, 320', loading: 'lazy', alt: item.image.alt | default: item.product.title | escape }}{% else %}<span class="cart-line-media product-placeholder"></span>{% endif %}<div><a class="cart-line-title" href="{{ item.url }}">{{ item.product.title }}</a>{% unless item.product.has_only_default_variant %}<p class="cart-line-meta">{{ item.variant.title }}</p>{% endunless %}<p>{{ item.final_line_price | money }}</p><label class="sr-only" for="CartQuantity-{{ forloop.index }}">{{ 'cart.quantity' | t: product: item.product.title }}</label><input id="CartQuantity-{{ forloop.index }}" class="field cart-quantity" type="number" min="0" value="{{ item.quantity }}" data-cart-line-input data-line="{{ forloop.index }}"></div></article>{% endfor %}</div>
      <div class="cart-page-footer"><p>{{ 'cart.subtotal' | t }} <strong>{{ cart.total_price | money_with_currency }}</strong></p><p class="cart-line-meta">{{ 'cart.note' | t }}</p><form action="{{ routes.cart_url }}" method="post"><button class="button button--primary" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button></form></div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"t:sections.cart.name"}{% endschema %}
