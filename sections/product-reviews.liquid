{%- liquid
  assign product_rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign has_reviews = false
  if product_rating != blank and rating_count > 0
    assign has_reviews = true
    assign rating_scale = product_rating.scale_max | default: 5
    assign rating_percent = product_rating.rating | divided_by: rating_scale | times: 100
  endif
-%}

<section class="product-reviews-section section-space" id="ProductReviews-{{ section.id }}">
  <div class="product-reviews-inner page-width" data-reveal>
    <header class="product-reviews-header">
      {% if has_reviews %}
        <div>
          {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
          <h2 class="serif-heading">{{ section.settings.heading }}</h2>
        </div>
        <div class="product-reviews-score" aria-label="{{ 'products.product.rating' | t: rating: product_rating.rating, maximum: rating_scale }}">
          <span class="product-reviews-stars" style="--rating-percent:{{ rating_percent }}%" aria-hidden="true">★★★★★</span>
          <strong>{{ product_rating.rating | round: 1 }}</strong>
          <span>{{ 'products.product.reviews' | t: count: rating_count }}</span>
        </div>
      {% else %}
        <div class="product-reviews-launch-copy">
          {% if section.settings.launch_eyebrow != blank %}<p class="eyebrow">{{ section.settings.launch_eyebrow }}</p>{% endif %}
          <h2 class="serif-heading">{{ section.settings.launch_heading }}</h2>
          {% if section.settings.launch_text != blank %}<div class="product-reviews-intro rte">{{ section.settings.launch_text }}</div>{% endif %}
          {% if section.settings.launch_button_label != blank %}
            <a class="text-link" href="{{ section.settings.launch_button_link | default: routes.all_products_collection_url }}">{{ section.settings.launch_button_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="product-reviews-app" aria-label="{{ section.settings.heading | escape }}">
        {% for block in section.blocks %}
          <div class="product-reviews-app-block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <div class="product-reviews-editor-note">
        <strong>{{ section.settings.editor_heading }}</strong>
        <p>{{ section.settings.editor_text }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.product_reviews.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.all.subheading", "default": "Island stories" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Worn, remembered, shared." },
    { "type": "header", "content": "t:sections.product_reviews.launch_state" },
    { "type": "text", "id": "launch_eyebrow", "label": "t:sections.product_reviews.launch_eyebrow", "default": "First arrivals" },
    { "type": "text", "id": "launch_heading", "label": "t:sections.product_reviews.launch_heading", "default": "Be among the first to wear Arrive Aruba." },
    { "type": "richtext", "id": "launch_text", "label": "t:sections.product_reviews.launch_text", "default": "<p>Our first island stories are still being lived. Discover the collection, then return to share where your Arrive piece took you.</p>" },
    { "type": "text", "id": "launch_button_label", "label": "t:sections.all.button_label", "default": "Discover the first collection" },
    { "type": "url", "id": "launch_button_link", "label": "t:sections.all.button_link" },
    { "type": "header", "content": "t:sections.product_reviews.editor_setup" },
    { "type": "text", "id": "editor_heading", "label": "t:sections.product_reviews.editor_heading", "default": "Connect your reviews app" },
    { "type": "textarea", "id": "editor_text", "label": "t:sections.product_reviews.editor_text", "default": "Add the review widget as an app block in this section. This setup note is visible only in the theme editor." }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "t:sections.product_reviews.name" }
  ]
}
{% endschema %}
