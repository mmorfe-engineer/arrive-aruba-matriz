<section class="aa-template aa-section">
  <div class="aa-shell">
    <h1 class="aa-title aa-reveal">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <p class="aa-copy">{{ 'cart.general.empty' | t }}</p>
      <p><a class="aa-button" href="{{ routes.all_products_collection_url }}">Shop the collection</a></p>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="aa-form aa-reveal">
        {%- for item in cart.items -%}
          <div class="aa-cart-line">
            {%- if item.image != blank -%}
              {{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', alt: item.product.title }}
            {%- endif -%}
            <div>
              <h2 class="aa-card__title">{{ item.product.title | escape }}</h2>
              <p class="aa-card__price">{{ item.final_line_price | money }}</p>
              <label>
                {{ 'products.product.quantity' | t }}
                <input class="aa-input" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </label>
              <p><a href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a></p>
            </div>
          </div>
        {%- endfor -%}

        <div class="aa-products-head">
          <strong>{{ 'cart.general.subtotal' | t }}: {{ cart.total_price | money }}</strong>
          <button class="aa-button" name="checkout" type="submit">{{ 'cart.general.checkout' | t }}</button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main cart"
}
{% endschema %}
