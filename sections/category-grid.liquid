<section class="category-section section-space">
  <div class="page-width">
    <div class="section-header" data-reveal>
      <div>{% if section.settings.subheading != blank %}<p class="eyebrow">{{ section.settings.subheading }}</p>{% endif %}<h2 class="serif-heading">{{ section.settings.heading }}</h2></div>
    </div>
    <div class="category-grid" style="--category-columns:{{ section.settings.columns }}">
      {% for block in section.blocks %}
        {%- assign card_link = block.settings.collection.url | default: block.settings.link -%}
        {%- assign card_image = block.settings.image | default: block.settings.collection.featured_image -%}
        <a class="category-card" href="{{ card_link | default: routes.all_products_collection_url }}" style="--category-color:{{ block.settings.background }}" {{ block.shopify_attributes }} data-reveal>
          {% if card_image != blank %}{{ card_image | image_url: width: 1400 | image_tag: widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 990px) 33vw, 50vw', loading: 'lazy', alt: card_image.alt | default: block.settings.heading | escape }}{% endif %}
          <span class="category-content"><span class="eyebrow">{{ block.settings.eyebrow }}</span><h3>{{ block.settings.heading | default: block.settings.collection.title }}</h3></span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.category_grid.name",
  "settings": [
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading", "default": "Made for island days" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Find your way to the water" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "default": 3, "label": "t:sections.category_grid.columns" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.category_grid.card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.all.collection" },
        { "type": "image_picker", "id": "image", "label": "t:sections.all.image" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.all.subheading", "default": "Explore" },
        { "type": "text", "id": "heading", "label": "t:sections.all.heading" },
        { "type": "url", "id": "link", "label": "t:sections.all.button_link" },
        { "type": "color", "id": "background", "label": "t:sections.category_grid.background", "default": "#5F8BB8" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "t:sections.category_grid.name", "blocks": [{ "type": "category", "settings": { "heading": "Swim" } }, { "type": "category", "settings": { "heading": "Resort" } }, { "type": "category", "settings": { "heading": "After sun" } }] }]
}
{% endschema %}
