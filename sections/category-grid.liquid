<section class="category-section section-space">
  <div class="page-width">
    <div class="section-header" data-reveal>
      <div>{% if section.settings.subheading != blank %}<p class="eyebrow">{{ section.settings.subheading }}</p>{% endif %}<h2 class="serif-heading">{{ section.settings.heading }}</h2></div>
    </div>
    <div class="category-grid{% if section.settings.stagger %} category-grid--stagger{% endif %}" style="--category-columns:{{ section.settings.columns }}">
      {%- assign columns = section.settings.columns -%}
      {% for block in section.blocks %}
        {%- assign card_link = block.settings.collection.url | default: block.settings.link -%}
        {%- assign card_image = block.settings.image | default: block.settings.collection.featured_image -%}
        {%- assign card_title = block.settings.heading | default: block.settings.collection.title -%}
        {%- assign desktop_column = forloop.index0 | modulo: columns -%}
        {%- assign desktop_offset = desktop_column | modulo: 2 -%}
        <a class="category-card" href="{{ card_link | default: routes.all_products_collection_url }}" style="--category-color:{{ block.settings.background }}" data-desktop-offset="{{ desktop_offset }}" {{ block.shopify_attributes }} data-reveal>
          <span class="category-card-media">
            {% if card_image != blank %}{{ card_image | image_url: width: 1400 | image_tag: widths: '400, 600, 900, 1200, 1400', sizes: '(min-width: 750px) 33vw, 50vw', loading: 'lazy', alt: card_image.alt | default: card_title | escape }}{% else %}{%- assign mark = 'arrive-logo-mark.svg' -%}{%- if desktop_offset == 1 -%}{%- assign mark = 'arrive-divi-divi.svg' -%}{%- endif -%}<span class="category-card-placeholder"><img src="{{ mark | asset_url }}" alt="" width="420" height="420" loading="lazy"></span>{% endif %}
            {% if block.settings.eyebrow != blank %}<span class="category-card-tag">{{ block.settings.eyebrow }}</span>{% endif %}
          </span>
          <span class="category-card-body">
            <span class="category-card-title">{{ card_title }}</span>
            {%- if block.settings.caption != blank -%}
              <span class="category-card-meta">{{ block.settings.caption }}</span>
            {%- elsif block.settings.collection != blank -%}
              <span class="category-card-meta">{{ 'collections.product_count' | t: count: block.settings.collection.all_products_count }}</span>
            {%- endif -%}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.category_grid.name",
  "settings": [
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Shop the Island" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "default": 2, "label": "t:sections.category_grid.columns" },
    { "type": "checkbox", "id": "stagger", "default": true, "label": "t:sections.category_grid.stagger", "info": "t:sections.category_grid.stagger_info" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:sections.category_grid.card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.all.collection" },
        { "type": "image_picker", "id": "image", "label": "t:sections.all.image" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.category_grid.tag" },
        { "type": "text", "id": "heading", "label": "t:sections.all.heading" },
        { "type": "text", "id": "caption", "label": "t:sections.category_grid.caption" },
        { "type": "url", "id": "link", "label": "t:sections.all.button_link" },
        { "type": "color", "id": "background", "label": "t:sections.category_grid.background", "default": "#5F8BB8" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "t:sections.category_grid.name", "blocks": [{ "type": "category", "settings": { "eyebrow": "Polo", "heading": "Resort Shirts", "background": "#5F8BB8" } }, { "type": "category", "settings": { "eyebrow": "Tee", "heading": "Performance Tees", "background": "#92AF88" } }, { "type": "category", "settings": { "eyebrow": "Layer", "heading": "Travel Layers", "background": "#386395" } }, { "type": "category", "settings": { "eyebrow": "All", "heading": "New Arrivals", "background": "#F5A169" } }] }]
}
{% endschema %}
