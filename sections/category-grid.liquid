<section class="aa-section">
  <div class="aa-shell aa-products-head aa-reveal">
    <div>
      <p class="aa-kicker">{{ section.settings.kicker | escape }}</p>
      <h2 class="aa-title">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="aa-button aa-button--ghost" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>

  <div class="aa-category-grid aa-reveal">
    {%- for block in section.blocks -%}
      <a class="aa-category" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 520, 720, 900', sizes: '(min-width: 760px) 25vw, 50vw', alt: block.settings.title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
        <span class="aa-category__label">
          {{ block.settings.title | escape }}
          <span>{{ block.settings.caption | escape }}</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for sunlit arrivals" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Linen" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Shirts" } },
        { "type": "category", "settings": { "title": "Caps" } },
        { "type": "category", "settings": { "title": "Sweaters" } },
        { "type": "category", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
