<section class="password-section"><div class="password-inner">{% if settings.logo_inverse != blank %}{{ settings.logo_inverse | image_url: width: 420 | image_tag: class: 'password-logo', widths: '180, 280, 420', loading: 'eager', alt: shop.name }}{% else %}<img class="password-logo" src="{{ 'arrive-logo-negative.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="500" height="260">{% endif %}<p class="eyebrow">Arrive Aruba</p><h1 class="serif-heading">{{ section.settings.heading }}</h1>{{ section.settings.text }}{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="prospect, password page"><label class="sr-only" for="PasswordEmail">{{ 'newsletter.email' | t }}</label><input class="field" id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required><button class="button button--light" type="submit">{{ 'newsletter.submit' | t }}</button>{% if form.posted_successfully? %}<p class="form-message">{{ 'newsletter.success' | t }}</p>{% endif %}{{ form.errors | default_errors }}{% endform %}<details class="password-access"><summary>{{ 'password.admin' | t }}</summary>{% form 'storefront_password' %}<label class="sr-only" for="StorePassword">{{ 'password.password' | t }}</label><input class="field" id="StorePassword" type="password" name="password"><button class="button button--light" type="submit">{{ 'password.submit' | t }}</button>{{ form.errors | default_errors }}{% endform %}</details></div></section>
{% schema %}{"name":"t:sections.password.name","settings":[{"type":"text","id":"heading","label":"t:sections.all.heading","default":"The island is almost here."},{"type":"richtext","id":"text","label":"t:sections.all.text","default":"<p>Enter your email for first access.</p>"}]}{% endschema %}
