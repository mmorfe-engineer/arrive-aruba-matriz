<section class="aa-template aa-section">
  <div class="aa-shell aa-product">
    <div class="aa-product__gallery aa-reveal">
      {%- for media in product.media -%}
        <div class="aa-product__image">
          {%- if media.media_type == 'image' -%}
            {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 760, 1000, 1400', sizes: '(min-width: 760px) 58vw, 100vw', alt: media.alt | default: product.title }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="aa-product__image">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endfor -%}
    </div>

    <div class="aa-product__summary aa-reveal">
      <p class="aa-kicker">{{ product.vendor | escape }}</p>
      <h1 class="aa-title">{{ product.title | escape }}</h1>
      <div class="aa-product__price">{{ product.selected_or_first_available_variant.price | money }}</div>
      {%- if product.description != blank -%}
        <div class="aa-copy">{{ product.description }}</div>
      {%- endif -%}

      {%- form 'product', product, class: 'aa-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <label class="aa-quantity">
          <span>{{ 'products.product.quantity' | t }}</span>
          <input class="aa-input" type="number" name="quantity" value="1" min="1">
        </label>

        <button class="aa-button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          {%- if product.selected_or_first_available_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
        {{ form | payment_button }}
      {%- endform -%}

      <div class="aa-service__item">
        <h3>{{ section.settings.service_title | escape }}</h3>
        <p>{{ section.settings.service_text | escape }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "text", "id": "service_title", "label": "Service title", "default": "Delivered with island ease" },
    { "type": "textarea", "id": "service_text", "label": "Service text", "default": "Secure checkout, local fulfillment options, and support for your stay." }
  ]
}
{% endschema %}
