  </div>
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {% if settings.logo_inverse != blank %}
          {{ settings.logo_inverse | image_url: width: 420 | image_tag:
            class: 'footer-logo',
            widths: '180, 280, 420',
            loading: 'lazy',
            alt: shop.name
          }}
        {% else %}
          <img class="footer-logo" src="{{ 'arrive-logo-negative.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="500" height="260" loading="lazy">
        {% endif %}
      </a>
      {% if section.settings.tagline != blank %}
        <p class="footer-copy">{{ section.settings.tagline | escape }}</p>
      {% endif %}
    </div>
    <div class="footer-navs">
      {% for block in section.blocks %}
        <div class="footer-nav" {{ block.shopify_attributes }}>
          <p class="footer-heading">{{ block.settings.heading | escape }}</p>
          {% if block.settings.menu != blank %}
            <ul class="footer-menu">
              {% for link in block.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <ul class="footer-menu">
              {% case forloop.index %}
                {% when 1 %}
                  <li><a href="/pages/island-story">{{ 'footer.menu_story' | t }}</a></li>
                  <li><a href="/pages/contact">{{ 'footer.menu_contact' | t }}</a></li>
                  <li><a href="{{ routes.search_url }}">{{ 'footer.menu_search' | t }}</a></li>
                {% when 2 %}
                  <li><a href="{{ routes.all_products_collection_url }}">{{ 'footer.menu_all' | t }}</a></li>
                  <li><a href="{{ routes.collections_url }}">{{ 'footer.menu_collections' | t }}</a></li>
                  <li><a href="{{ routes.cart_url }}">{{ 'footer.menu_bag' | t }}</a></li>
                {% else %}
                  <li><a href="mailto:{{ settings.contact_email | default: 'info@arrivearuba.com' | escape }}">{{ 'footer.menu_service' | t }}</a></li>
                  <li><a href="mailto:{{ settings.contact_email | default: 'info@arrivearuba.com' | escape }}?subject=Shipping%20question">{{ 'footer.menu_shipping' | t }}</a></li>
                  <li><a href="mailto:{{ settings.contact_email | default: 'info@arrivearuba.com' | escape }}?subject=Returns%20question">{{ 'footer.menu_returns' | t }}</a></li>
              {% endcase %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <div class="footer-social-callout">
      <p class="footer-heading">{{ 'footer.social_title' | t }}</p>
      <p class="footer-social-copy">{{ 'footer.social_copy' | t }}</p>
      <nav class="footer-social" aria-label="{{ 'footer.socials' | t }}">
        {% if settings.social_instagram != blank %}<a href="{{ settings.social_instagram | escape }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{% endif %}
        {% if settings.social_facebook != blank %}<a href="{{ settings.social_facebook | escape }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{% endif %}
        {% if settings.social_tiktok != blank %}<a href="{{ settings.social_tiktok | escape }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{% endif %}
        {% if settings.social_x != blank %}<a href="{{ settings.social_x | escape }}" aria-label="X">{% render 'icon', name: 'x' %}</a>{% endif %}
      </nav>
      <div class="footer-contact-links">
        {% if settings.official_domain != blank %}<a href="{{ settings.official_domain | escape }}">{{ 'footer.website' | t }}</a>{% endif %}
        {% if settings.contact_email != blank %}<a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a>{% endif %}
      </div>
    </div>
    {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
      {% form 'localization', class: 'localization-form' %}
        {% if localization.available_countries.size > 1 %}
          <label class="sr-only" for="FooterCountry">{{ 'localization.country' | t }}</label>
          <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
            {% for country in localization.available_countries %}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
            {% endfor %}
          </select>
        {% endif %}
        {% if localization.available_languages.size > 1 %}
          <label class="sr-only" for="FooterLanguage">{{ 'localization.language' | t }}</label>
          <select id="FooterLanguage" name="locale_code" onchange="this.form.submit()">
            {% for language in localization.available_languages %}
              <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>
            {% endfor %}
          </select>
        {% endif %}
      {% endform %}
    {% endif %}
  </div>
  <div class="footer-bottom">
    <p class="footer-legal">&copy; {{ 'now' | date: '%Y' }} Arrive Aruba. {{ 'footer.rights' | t }}</p>
    <a class="footer-agency" href="https://www.upwork.com/agencies/2049134329997668985/" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.agency_credit' | t }}">
      <img src="{{ 'morfe-maison-icon-white.svg' | asset_url }}" alt="" width="241" height="358" loading="lazy" aria-hidden="true">
      <span>{{ 'footer.agency_credit_prefix' | t }} <strong>Morfe Maison</strong></span>
    </a>
    {% if settings.social_pinterest != blank or settings.social_whatsapp != blank %}
      <nav class="footer-secondary-social" aria-label="{{ 'footer.additional_socials' | t }}">
        {% if settings.social_pinterest != blank %}<a href="{{ settings.social_pinterest | escape }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>{% endif %}
        {% if settings.social_whatsapp != blank %}<a href="{{ settings.social_whatsapp | escape }}" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp' %}</a>{% endif %}
      </nav>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "t:sections.footer.tagline",
      "default": "Resortwear shaped by the island."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.menu_block",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.all.heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.all.menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [
        {
          "type": "menu"
        },
        {
          "type": "menu"
        }
      ]
    }
  ]
}
{% endschema %}
