<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      {% if settings.logo_inverse != blank %}{{ settings.logo_inverse | image_url: width: 420 | image_tag: class: 'footer-logo', widths: '180, 280, 420', loading: 'lazy', alt: shop.name }}{% else %}<img class="footer-logo" src="{{ 'arrive-logo-negative.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="500" height="260" loading="lazy">{% endif %}
      {% if section.settings.tagline != blank %}<p class="footer-copy">{{ section.settings.tagline }}</p>{% endif %}
    </div>
    <div class="footer-navs">{% for block in section.blocks %}<div class="footer-nav" {{ block.shopify_attributes }}><p class="footer-heading">{{ block.settings.heading }}</p>{% if block.settings.menu != blank %}<ul class="footer-menu">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>{% endif %}</div>{% endfor %}</div>
    {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}{% form 'localization', class: 'localization-form' %}{% if localization.available_countries.size > 1 %}<label class="sr-only" for="FooterCountry">{{ 'localization.country' | t }}</label><select id="FooterCountry" name="country_code" onchange="this.form.submit()">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>{% endfor %}</select>{% endif %}{% if localization.available_languages.size > 1 %}<label class="sr-only" for="FooterLanguage">{{ 'localization.language' | t }}</label><select id="FooterLanguage" name="locale_code" onchange="this.form.submit()">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>{% endfor %}</select>{% endif %}{% endform %}{% endif %}
  </div>
  <div class="footer-bottom">
    <p class="footer-legal">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
    <div class="footer-social">{% if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}">Instagram</a>{% endif %}{% if settings.social_tiktok != blank %}<a href="{{ settings.social_tiktok }}">TikTok</a>{% endif %}{% if settings.social_facebook != blank %}<a href="{{ settings.social_facebook }}">Facebook</a>{% endif %}</div>
  </div>
</footer>
{% schema %}
{"name":"t:sections.footer.name","settings":[{"type":"textarea","id":"tagline","label":"t:sections.footer.tagline","default":"Resortwear shaped by the island."}],"blocks":[{"type":"menu","name":"t:sections.footer.menu_block","limit":3,"settings":[{"type":"text","id":"heading","label":"t:sections.all.heading","default":"Explore"},{"type":"link_list","id":"menu","label":"t:sections.all.menu"}]}],"presets":[{"name":"t:sections.footer.name","blocks":[{"type":"menu"},{"type":"menu"}]}]}
{% endschema %}
