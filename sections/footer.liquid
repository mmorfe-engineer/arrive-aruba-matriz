<footer class="aa-footer aa-section">
  <div class="aa-shell aa-footer__grid">
    <div>
      <div class="aa-footer__brand">{{ section.settings.brand_word | escape }}</div>
      <p class="aa-footer__small">{{ section.settings.tagline | escape }}</p>
    </div>

    <nav class="aa-footer__nav" aria-label="Footer">
      <p class="aa-kicker">{{ section.settings.menu_heading | escape }}</p>
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {%- endfor -%}
    </nav>

    <nav class="aa-footer__nav" aria-label="Services">
      <p class="aa-kicker">{{ section.settings.service_heading | escape }}</p>
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
      {%- endfor -%}
    </nav>

    <div>
      <p class="aa-kicker">{{ section.settings.newsletter_heading | escape }}</p>
      <p class="aa-footer__small">{{ section.settings.newsletter_text | escape }}</p>
      {%- form 'customer', class: 'aa-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input class="aa-input" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'general.newsletter.email' | t }}" required>
        <button class="aa-button aa-button--light" type="submit">{{ 'general.newsletter.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_word",
      "label": "Large brand word",
      "default": "Arrive"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Take home what you felt."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Menu heading",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "service_heading",
      "label": "Service heading",
      "default": "Services"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Island notes"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Quiet updates on new arrivals, island stories, and limited resortwear releases."
    }
  ],
  "blocks": [
    {
      "type": "service_link",
      "name": "Service link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "24-hour delivery"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "service_link" },
        { "type": "service_link", "settings": { "label": "Security & privacy" } },
        { "type": "service_link", "settings": { "label": "Help & support" } }
      ]
    }
  ]
}
{% endschema %}
