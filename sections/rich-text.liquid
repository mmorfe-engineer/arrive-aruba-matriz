<section class="heritage-section section-space">
  <div class="page-width narrow-content" style="text-align:{{ section.settings.alignment }}" data-reveal>
    {% if section.settings.subheading != blank %}<p class="eyebrow">{{ section.settings.subheading }}</p>{% endif %}
    <h2 class="serif-heading">{{ section.settings.heading }}</h2>
    <div class="rte prose">{{ section.settings.text }}</div>
    {% if section.settings.button_label != blank %}<a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}
  </div>
</section>
{% schema %}
{"name":"t:sections.rich_text.name","settings":[{"type":"text","id":"subheading","label":"t:sections.all.subheading","default":"Our point of view"},{"type":"text","id":"heading","label":"t:sections.all.heading","default":"Designed in the rhythm of Aruba."},{"type":"richtext","id":"text","label":"t:sections.all.text","default":"<p>Arrive Aruba is resortwear for the moments that stay with you: bright water, warm evenings and the ease of island time.</p>"},{"type":"select","id":"alignment","label":"t:sections.all.alignment","default":"left","options":[{"value":"left","label":"t:options.left"},{"value":"center","label":"t:options.center"}]},{"type":"text","id":"button_label","label":"t:sections.all.button_label"},{"type":"url","id":"button_link","label":"t:sections.all.button_link"}],"presets":[{"name":"t:sections.rich_text.name"}]}
{% endschema %}
