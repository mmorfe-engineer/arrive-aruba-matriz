<product-recommendations class="product-recommendations-section" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}">
  {% if recommendations.performed? and recommendations.products_count > 0 %}
    <div class="product-recommendations-inner"><div class="section-header"><div>{% if section.settings.subheading != blank %}<p class="eyebrow">{{ section.settings.subheading }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="serif-heading">{{ section.settings.heading }}</h2>{% endif %}</div></div><div class="product-grid">{% for product in recommendations.products %}{% render 'product-card', product: product, show_wishlist: false, delay: forloop.index0 %}{% endfor %}</div></div>
  {% endif %}
</product-recommendations>
{% schema %}
{
  "name": "t:sections.recommendations.name",
  "settings": [
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading", "default": "Keep exploring" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "More from the island" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "default": 4, "label": "t:sections.all.products_to_show" },
    { "type": "select", "id": "intent", "label": "t:sections.recommendations.intent", "default": "related", "options": [{ "value": "related", "label": "t:options.related" }, { "value": "complementary", "label": "t:options.complementary" }] }
  ]
}
{% endschema %}
