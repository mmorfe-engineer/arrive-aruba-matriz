<section class="main-page section-space"><div class="page-width"><header class="section-header"><div><p class="eyebrow">Island notes</p><h1 class="display-heading">{{ blog.title }}</h1></div></header>{% paginate blog.articles by section.settings.articles_per_page %}<div class="editorial-cards">{% for article in blog.articles %}<article class="editorial-card">{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 1200 | image_tag: widths: '400, 700, 900, 1200', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | default: article.title | escape }}</a>{% endif %}<p class="eyebrow">{{ article.published_at | date: format: 'date' }}</p><h2 class="serif-heading"><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p><a class="text-link" href="{{ article.url }}">{{ 'blogs.read_more' | t }}</a></article>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</div></section>
{% schema %}{"name":"t:sections.blog.name","settings":[{"type":"range","id":"articles_per_page","min":3,"max":24,"step":3,"default":9,"label":"t:sections.blog.articles_per_page"}]}{% endschema %}
