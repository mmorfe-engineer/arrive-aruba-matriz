<article class="main-page section-space"><div class="page-width narrow-content"><header class="page-hero"><p class="eyebrow">{{ article.published_at | date: format: 'date' }}</p><h1 class="display-heading">{{ article.title }}</h1></header>{% if article.image %}{{ article.image | image_url: width: 1800 | image_tag: widths: '750, 1100, 1500, 1800', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: article.image.alt | default: article.title | escape }}{% endif %}<div class="rte prose">{{ article.content }}</div><p><a class="text-link" href="{{ blog.url }}">{{ 'blogs.back' | t }}</a></p></div></article>
{% schema %}{"name":"t:sections.article.name"}{% endschema %}
