<section class="collection-section section-space"><div class="page-width"><header class="section-header"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 class="serif-heading">{{ section.settings.heading }}</h1></div></header><div class="category-grid">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<a class="category-card" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 1200 | image_tag: widths: '400, 700, 900, 1200', sizes: '(min-width: 750px) 33vw, 50vw', loading: 'lazy', alt: collection.featured_image.alt | default: collection.title | escape }}{% endif %}<span class="category-content"><span class="eyebrow">{{ 'collections.product_count' | t: count: collection.products_count }}</span><h3>{{ collection.title }}</h3></span></a>{% endunless %}{% endfor %}</div></div></section>
{% schema %}{"name":"t:sections.list_collections.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.all.subheading","default":"Arrive Aruba"},{"type":"text","id":"heading","label":"t:sections.all.heading","default":"Collections"}]}{% endschema %}
