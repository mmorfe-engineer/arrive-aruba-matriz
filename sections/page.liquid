<section class="main-page section-space">
  <div class="page-width narrow-content">
    <header class="page-hero"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 class="display-heading">{{ page.title }}</h1></header>
    <div class="rte prose">{{ page.content }}</div>
  </div>
</section>
{% schema %}{"name":"t:sections.main_page.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.all.subheading","default":"Arrive Aruba"}]}{% endschema %}
