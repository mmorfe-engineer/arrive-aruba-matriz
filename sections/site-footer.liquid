{% comment %}
  ARRIVE ARUBA — Site Footer
  Shopify OS 2.0 · Footer mejorado basado en el diseño original
  Basado en Arrive Aruba - Homepage.dc.html
{% endcomment %}

<style>
  .aa-footer-wrap {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    color: {{ section.settings.text_color }};
  }

  .aa-footer-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px 28px;
    max-width: 640px;
    margin: 0 auto {{ section.settings.main_margin_bottom }}px;
  }

  @media (max-width: 767px) {
    .aa-footer-main {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    
    .aa-footer-column:nth-child(2) {
      grid-column: 1 / -1;
    }
    
    .aa-footer-column:nth-child(3) {
      grid-column: 1 / -1;
    }
  }

  .aa-footer-logo-section {
    grid-column: 1 / -1;
  }

  .aa-footer-logo {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    display: block;
    margin-bottom: 12px;
  }

  .aa-footer-tagline {
    font-family: 'Geologica', sans-serif;
    font-weight: 300;
    font-size: {{ section.settings.tagline_size }}px;
    line-height: 1.75;
    color: rgba(240, 240, 229, 0.35);
  }

  .aa-footer-column {
    margin-top: 24px;
  }

  .aa-footer-column-title {
    font-family: 'Geologica', sans-serif;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240, 240, 229, 0.35);
    margin-bottom: 14px;
  }

  .aa-footer-column-links {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .aa-footer-link {
    font-family: 'Geologica', sans-serif;
    font-size: 12px;
    color: rgba(240, 240, 229, 0.5);
    font-weight: 300;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .aa-footer-link:hover {
    color: rgba(240, 240, 229, 0.85);
  }

  .aa-footer-bottom {
    border-top: 1px solid rgba(240, 240, 229, 0.07);
    padding-top: 24px;
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .aa-footer-copyright {
    font-family: 'Geologica', sans-serif;
    font-size: 9px;
    color: rgba(240, 240, 229, 0.22);
    font-weight: 300;
    letter-spacing: 0.04em;
  }

  .aa-footer-social {
    display: flex;
    gap: 18px;
  }

  .aa-footer-social-link {
    font-family: 'Geologica', sans-serif;
    font-size: 9px;
    color: rgba(240, 240, 229, 0.32);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .aa-footer-social-link:hover {
    color: rgba(240, 240, 229, 0.7);
  }

  /* Newsletter section */
  .aa-footer-newsletter {
    grid-column: 1 / -1;
    margin-bottom: 44px;
  }

  .aa-newsletter-title {
    font-family: 'Geologica', sans-serif;
    font-size: 9px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(240, 240, 229, 0.35);
    margin-bottom: 8px;
  }

  .aa-newsletter-form {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .aa-newsletter-input {
    flex: 1;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(240, 240, 229, 0.2);
    padding: 10px 0;
    font-family: 'Geologica', sans-serif;
    font-size: 13px;
    color: rgba(240, 240, 229, 0.7);
    outline: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .aa-newsletter-input::placeholder {
    color: rgba(240, 240, 229, 0.35);
  }

  .aa-newsletter-input:focus {
    border-color: rgba(240, 240, 229, 0.6);
    color: rgba(240, 240, 229, 0.9);
  }

  .aa-newsletter-button {
    background: none;
    border: none;
    color: rgba(240, 240, 229, 0.5);
    font-family: 'Geologica', sans-serif;
    font-size: 13px;
    cursor: pointer;
    transition: color 0.2s ease;
    padding: 10px 0;
  }

  .aa-newsletter-button:hover {
    color: rgba(240, 240, 229, 0.9);
  }
</style>

<footer class="aa-footer-wrap" role="contentinfo">
  {% if section.settings.show_newsletter %}
    <div class="aa-footer-newsletter">
      {% if section.settings.newsletter_title != blank %}
        <p class="aa-newsletter-title">{{ section.settings.newsletter_title }}</p>
      {% endif %}
      <form class="aa-newsletter-form" action="{{ section.settings.newsletter_action }}" method="post">
        <input 
          type="email" 
          name="email" 
          class="aa-newsletter-input"
          placeholder="{{ section.settings.newsletter_placeholder }}"
          required
        />
        <button type="submit" class="aa-newsletter-button">{{ section.settings.newsletter_button_text }}</button>
      </form>
    </div>
  {% endif %}

  <div class="aa-footer-main">
    <div class="aa-footer-logo-section">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'aa-footer-logo', loading: 'lazy', alt: section.settings.logo_alt }}
      {% else %}
        <img 
          src="{{ 'arrive-logo-negative.webp' | asset_url }}"
          alt="Arrive Aruba" 
          class="aa-footer-logo"
          loading="lazy"
          width="640"
          height="429"
        >
      {% endif %}
      <p class="aa-footer-tagline">{{ section.settings.tagline }}</p>
    </div>

    {% if section.settings.show_shop_links %}
      <div class="aa-footer-column">
        <p class="aa-footer-column-title">{{ section.settings.shop_title }}</p>
        <div class="aa-footer-column-links">
          {% for link in section.settings.shop_links %}
            <a href="{{ link.url }}" class="aa-footer-link">{{ link.text }}</a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_help_links %}
      <div class="aa-footer-column">
        <p class="aa-footer-column-title">{{ section.settings.help_title }}</p>
        <div class="aa-footer-column-links">
          {% for link in section.settings.help_links %}
            <a href="{{ link.url }}" class="aa-footer-link">{{ link.text }}</a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_info_links %}
      <div class="aa-footer-column">
        <p class="aa-footer-column-title">{{ section.settings.info_title }}</p>
        <div class="aa-footer-column-links">
          {% for link in section.settings.info_links %}
            <a href="{{ link.url }}" class="aa-footer-link">{{ link.text }}</a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="aa-footer-bottom">
    <p class="aa-footer-copyright">{{ section.settings.copyright_text }}</p>
    
    {% if section.settings.show_social_links %}
      <div class="aa-footer-social">
        {% for social in section.settings.social_links %}
          <a href="{{ social.url }}" class="aa-footer-social-link">{{ social.text }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

