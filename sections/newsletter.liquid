<section class="newsletter">
  <div class="newsletter-inner" data-reveal>
    {% if section.settings.subheading != blank %}<p class="eyebrow">{{ section.settings.subheading }}</p>{% endif %}
    <h2 class="serif-heading">{{ section.settings.heading }}</h2>
    {{ section.settings.text }}
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr-only" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
      <input class="field" id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" placeholder="{{ 'newsletter.email' | t }}" required>
      <button class="button button--light" type="submit">{{ 'newsletter.submit' | t }}</button>
      {% if form.posted_successfully? %}<p class="form-message" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>{% endif %}
      {% if form.errors %}<div class="form-message">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading", "default": "Postcards from Aruba" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Stay close to the island." },
    { "type": "richtext", "id": "text", "label": "t:sections.all.text", "default": "<p>New pieces, island notes and first access, sent occasionally.</p>" }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
