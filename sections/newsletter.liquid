<section class="aa-newsletter aa-section">
  <div class="aa-shell aa-reveal">
    <p class="aa-kicker">{{ section.settings.kicker | escape }}</p>
    <h2 class="aa-title">{{ section.settings.heading | escape }}</h2>
    <p class="aa-copy" style="margin-inline:auto;">{{ section.settings.text | escape }}</p>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input class="aa-input" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'general.newsletter.email' | t }}" required>
      <button class="aa-button" type="submit">{{ section.settings.button_label | escape }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Arrive updates" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quietly stay close to the island" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New pieces, limited releases, and notes from Aruba." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
