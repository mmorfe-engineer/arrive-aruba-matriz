{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="main-product">
  <div class="product-layout" data-section-id="{{ section.id }}">
    <div class="product-gallery" aria-label="{{ product.title | escape }}" style="--product-media-fit:{{ section.settings.media_fit }}">
      {% if product.media.size > 0 %}
        {% for media in product.media %}<div class="product-media" data-media-id="{{ media.id }}">{% render 'product-media', media: media, eager: forloop.first %}</div>{% endfor %}
      {% else %}
        <div class="product-media product-placeholder"><img src="{{ 'arrive-logo-mark.svg' | asset_url }}" alt="" width="420" height="420"></div>
      {% endif %}
    </div>
    <div class="product-info">
      <div class="product-info-inner">
        <p class="eyebrow">{% if product.type != blank %}{{ product.type }} · {% elsif section.settings.show_vendor and product.vendor != blank %}{{ product.vendor }} · {% endif %}Arrive Aruba</p>
        <div class="product-title-row">
          <h1 class="product-title">{{ product.title }}</h1>
          <button class="icon-button product-save" type="button" data-wishlist="{{ product.id }}" data-wishlist-title="{{ product.title | escape }}" data-wishlist-url="{{ product.url }}" data-wishlist-price="{{ product.price | money | escape }}"{% if product.featured_media %} data-wishlist-image="{{ product.featured_media.preview_image | image_url: width: 240 }}"{% endif %} data-wishlist-message="{{ 'wishlist.updated' | t | escape }}" aria-label="{{ 'wishlist.toggle' | t: product: product.title | escape }}" aria-pressed="false">{% render 'icon', name: 'heart' %}</button>
        </div>
        <div class="product-price-row"><div class="product-price">{% render 'price', product: product, variant: current_variant %}</div>{% if section.settings.delivery_note != blank %}<span>{{ section.settings.delivery_note }}</span>{% endif %}</div>
        {% if cart.taxes_included %}<p class="cart-line-meta">{{ 'products.product.tax_included' | t }}</p>{% else %}<p class="cart-line-meta">{{ 'products.product.tax_at_checkout' | t }}</p>{% endif %}
        {%- assign product_rating = product.metafields.reviews.rating.value -%}
        {% if product_rating != blank %}<div class="product-rating" aria-label="{{ product_rating.rating }} out of {{ product_rating.scale_max }} stars"><span aria-hidden="true">★★★★★</span><span>{{ product_rating.rating | round: 1 }}{% if product.metafields.reviews.rating_count != blank %} · {{ product.metafields.reviews.rating_count }} reviews{% endif %}</span></div>{% endif %}
        {% if section.settings.show_description and product.description != blank %}<div class="product-description rte">{{ product.description }}</div>{% endif %}

        <product-form>
          {% form 'product', product, id: 'ProductForm-' | append: section.id %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            {% unless product.has_only_default_variant %}
              {% for option in product.options_with_values %}
                {%- liquid
                  assign option_name = option.name | downcase
                  assign is_color_option = false
                  if option_name contains 'color' or option_name contains 'colour'
                    assign is_color_option = true
                  endif
                -%}
                <fieldset class="product-option">
                  <legend><span>{{ option.name }}: <span data-selected-option>{{ option.selected_value }}</span></span>{% if option_name contains 'size' and product.metafields.custom.size_guide != blank %}<a href="#ProductDetails-{{ section.id }}">{{ 'products.product.size_guide' | t }}</a>{% endif %}</legend>
                  <div class="option-values">
                    {% for option_value in option.values %}
                      <input class="option-input" id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" type="radio" name="options[{{ option.name | escape }}]" value="{{ option_value | escape }}" data-option-input{% if option.selected_value == option_value %} checked{% endif %}{% unless option_value.available %} disabled{% endunless %}>
                      <label class="option-label{% if is_color_option %} option-label--swatch swatch--{{ option_value | handle }}{% endif %}" for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" title="{{ option_value | escape }}"{% if is_color_option and option_value.swatch.color %} style="--swatch-color:rgb({{ option_value.swatch.color.rgb }})"{% elsif is_color_option and option_value.swatch.image %} style="--swatch-image:url('{{ option_value.swatch.image | image_url: width: 96 }}')"{% endif %}>{% if is_color_option %}<span class="sr-only">{{ option_value }}</span>{% else %}{{ option_value }}{% endif %}</label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            {% endunless %}
            <label class="eyebrow" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
            <div class="quantity">
              <button type="button" data-quantity-change="-1" aria-label="Decrease quantity">−</button>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
              <button type="button" data-quantity-change="1" aria-label="Increase quantity">+</button>
            </div>
            <button class="button button--primary product-submit" type="submit" data-product-submit data-available-label="{{ 'products.product.add_to_cart' | t | escape }}" data-sold-label="{{ 'products.product.sold_out' | t | escape }}" data-added-label="{{ 'products.product.added_to_cart' | t | escape }}"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>
            {% if section.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}
            {% if section.settings.show_sticky_mobile %}<div class="product-sticky-bar"><button class="button button--primary product-submit" type="submit" data-product-submit data-available-label="{{ 'products.product.add_to_cart' | t | escape }}" data-sold-label="{{ 'products.product.sold_out' | t | escape }}" data-added-label="{{ 'products.product.added_to_cart' | t | escape }}"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button></div>{% endif %}
          {% endform %}
          <script type="application/json" data-variants>{{ product.variants | json }}</script>
        </product-form>

        {% if section.settings.delivery_heading != blank %}<div class="product-delivery">{% render 'icon', name: 'truck' %}<div><strong>{{ section.settings.delivery_heading }}</strong>{% if section.settings.delivery_text != blank %}<p>{{ section.settings.delivery_text }}</p>{% endif %}</div></div>{% endif %}

        <div class="product-details" id="ProductDetails-{{ section.id }}">
          {% if product.description != blank and section.settings.show_description == false %}<details open><summary>{{ 'products.product.details' | t }}</summary><div class="product-details-content rte">{{ product.description }}</div></details>{% endif %}
          {% if section.settings.show_metafields %}
            {% assign fields = 'materials,care,fit,size_guide' | split: ',' %}
            {% for field in fields %}{% assign detail = product.metafields.custom[field] %}{% if detail != blank %}<details><summary>{% case field %}{% when 'materials' %}{{ 'products.product.materials' | t }}{% when 'care' %}{{ 'products.product.care' | t }}{% when 'fit' %}{{ 'products.product.fit' | t }}{% when 'size_guide' %}{{ 'products.product.size_guide' | t }}{% endcase %}</summary><div class="product-details-content rte">{{ detail | metafield_tag }}</div></details>{% endif %}{% endfor %}
          {% endif %}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'collapsible' %}{% if block.settings.heading != blank %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="product-details-content rte">{{ block.settings.content }}</div></details>{% endif %}
              {% when '@app' %}{% render block %}
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.product.name",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.product.show_vendor", "default": false },
    { "type": "checkbox", "id": "show_description", "label": "t:sections.product.show_description", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:sections.product.show_dynamic_checkout", "default": true },
    { "type": "checkbox", "id": "show_metafields", "label": "t:sections.product.show_metafields", "default": true },
    { "type": "checkbox", "id": "show_sticky_mobile", "label": "t:sections.product.show_sticky_mobile", "default": true },
    { "type": "text", "id": "delivery_note", "label": "t:sections.product.delivery_note", "default": "Free delivery to Aruba" },
    { "type": "text", "id": "delivery_heading", "label": "t:sections.product.delivery_heading", "default": "Delivered in 24 hours across Aruba" },
    { "type": "text", "id": "delivery_text", "label": "t:sections.product.delivery_text", "default": "Free on orders over $150 · Island ease guaranteed" },
    { "type": "select", "id": "media_fit", "label": "t:sections.product.media_fit", "default": "contain", "options": [{ "value": "cover", "label": "t:options.cover" }, { "value": "contain", "label": "t:options.contain" }] }
  ],
  "blocks": [
    { "type": "collapsible", "name": "t:sections.product.collapsible", "settings": [{ "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Shipping and returns" }, { "type": "richtext", "id": "content", "label": "t:sections.all.text", "default": "<p>Add shipping and returns information here.</p>" }] },
    { "type": "@app" }
  ]
}
{% endschema %}
