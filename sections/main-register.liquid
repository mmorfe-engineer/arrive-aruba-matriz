<section class="aa-template aa-section">
  <div class="aa-shell" style="max-width: 560px;">
    <div class="aa-reveal">
      <p class="aa-kicker">Arrive Aruba</p>
      <h1 class="aa-title">Sign in</h1>
      {%- form 'create_customer', class: 'aa-form' -%}
        {{ form.errors | default_errors }}
        <input class="aa-input" type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name">
        <input class="aa-input" type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name">
        <input class="aa-input" type="email" name="customer[email]" autocomplete="email" placeholder="Email" required>
        <input class="aa-input" type="password" name="customer[password]" autocomplete="new-password" placeholder="Password" required>
        <button class="aa-button" type="submit">Create account</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main register"
}
{% endschema %}
