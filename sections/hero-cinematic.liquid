<section class="aa-hero" style="--hero-focus-x: {{ section.settings.image.presentation.focal_point.x | default: 50 }}%;">
  <div class="aa-hero__media" {% if settings.enable_parallax %}data-aa-parallax{% endif %}>
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1800x' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1400, 1800, 2200', sizes: '100vw', alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="aa-hero__content aa-reveal">
    <p class="aa-kicker">{{ section.settings.kicker | escape }}</p>
    <h1 class="aa-hero__tagline">
      {{ section.settings.heading_line_1 | escape }}
      <em>{{ section.settings.heading_line_2 | escape }}</em>
    </h1>
    <p class="aa-hero__text">{{ section.settings.text | escape }}</p>
    <div class="aa-hero__actions">
      {%- if section.settings.primary_label != blank -%}
        <a class="aa-button aa-button--light" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="aa-button aa-button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="aa-hero__peek">{{ section.settings.peek_label | escape }}</div>
</section>

{% schema %}
{
  "name": "Cinematic hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "video", "id": "video", "label": "Hero video" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Arrive Aruba" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Take home" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "what you felt" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Resortwear shaped by the island, delivered with quiet ease." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Shop the collection" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Discover the island story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "peek_label", "label": "Scroll hint", "default": "Begin" }
  ],
  "presets": [
    { "name": "Cinematic hero" }
  ]
}
{% endschema %}
