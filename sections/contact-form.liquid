<section class="main-contact">
  <div class="contact-hero">
    <div class="contact-hero-copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1 class="display-heading">{{ section.settings.heading | default: page.title }}</h1>
      <div class="rte">{{ section.settings.text }}{{ page.content }}</div>
    </div>
    <div class="contact-hero-media" aria-hidden="true">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 42vw, 100vw', loading: 'eager', alt: section.settings.heading | escape }}
      {% else %}
        <img src="{{ 'arrive-resort-editorial.jpg' | asset_url }}" alt="" width="1200" height="1400" loading="eager">
      {% endif %}
    </div>
  </div>

  <div class="page-width contact-layout">
    <aside class="contact-service-panel">
      {% if section.blocks.size > 0 %}
        <div class="contact-service-grid">
          {% for block in section.blocks %}
            <div class="contact-service-card" {{ block.shopify_attributes }}>
              {% if block.settings.label != blank %}<span>{{ block.settings.label }}</span>{% endif %}
              {% if block.settings.title != blank %}<strong>{{ block.settings.title }}</strong>{% endif %}
              {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
      {% if section.settings.note != blank %}<p class="contact-note">{{ section.settings.note }}</p>{% endif %}
    </aside>

    <div class="contact-form-panel">
      {% form 'contact', class: 'contact-form' %}
        {% if form.posted_successfully? %}<p class="form-message" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>{% endif %}
        {% if form.errors %}<div class="form-message">{{ form.errors | default_errors }}</div>{% endif %}

        <div class="contact-row">
          <div>
            <label for="ContactName">{{ 'contact.name' | t }}</label>
            <input class="field" id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name">
          </div>
          <div>
            <label for="ContactEmail">{{ 'contact.email' | t }}</label>
            <input class="field" id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
          </div>
        </div>

        <div class="contact-row">
          <div>
            <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
            <input class="field" id="ContactPhone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
          </div>
          <div>
            <label for="ContactTopic">{{ 'contact.topic' | t }}</label>
            <select class="field" id="ContactTopic" name="contact[topic]">
              <option value="{{ 'contact.topic_order' | t }}">{{ 'contact.topic_order' | t }}</option>
              <option value="{{ 'contact.topic_sizing' | t }}">{{ 'contact.topic_sizing' | t }}</option>
              <option value="{{ 'contact.topic_island' | t }}">{{ 'contact.topic_island' | t }}</option>
            </select>
          </div>
        </div>

        <div>
          <label for="ContactMessage">{{ 'contact.message' | t }}</label>
          <textarea class="field" id="ContactMessage" name="contact[body]" rows="7" required>{{ form.body }}</textarea>
        </div>

        <button class="button button--primary" type="submit">{{ 'contact.send' | t }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.all.subheading", "default": "From the island" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Let's stay in touch." },
    { "type": "richtext", "id": "text", "label": "t:sections.all.text", "default": "<p>Questions about a piece, an order or the story? Send us a note.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "note", "label": "Service note", "default": "For order support, include your order number so the team can help faster." }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Support" },
        { "type": "text", "id": "title", "label": "Title", "default": "24-hour island delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Delivery across Aruba with resort-friendly coordination." }
      ]
    }
  ]
}
{% endschema %}
