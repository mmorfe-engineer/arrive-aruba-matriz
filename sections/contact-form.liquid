<section class="main-contact section-space">
  <div class="page-width contact-layout">
    <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 class="display-heading">{{ page.title | default: section.settings.heading }}</h1><div class="rte">{{ section.settings.text }}{{ page.content }}</div></div>
    {% form 'contact', class: 'contact-form' %}
      {% if form.posted_successfully? %}<p class="form-message" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>{% endif %}
      {% if form.errors %}<div class="form-message">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="contact-row"><div><label for="ContactName">{{ 'contact.name' | t }}</label><input class="field" id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name"></div><div><label for="ContactEmail">{{ 'contact.email' | t }}</label><input class="field" id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required></div></div>
      <label for="ContactPhone">{{ 'contact.phone' | t }}</label><input class="field" id="ContactPhone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
      <label for="ContactMessage">{{ 'contact.message' | t }}</label><textarea class="field" id="ContactMessage" name="contact[body]" rows="7" required>{{ form.body }}</textarea>
      <button class="button button--primary" type="submit">{{ 'contact.send' | t }}</button>
    {% endform %}
  </div>
</section>
{% schema %}{"name":"t:sections.contact.name","settings":[{"type":"text","id":"eyebrow","label":"t:sections.all.subheading","default":"From the island"},{"type":"text","id":"heading","label":"t:sections.all.heading","default":"Let’s stay in touch."},{"type":"richtext","id":"text","label":"t:sections.all.text","default":"<p>Questions about a piece, an order or the story? Send us a note.</p>"}]}{% endschema %}
