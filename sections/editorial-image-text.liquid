{%- assign editorial_image = section.settings.image -%}
<section class="editorial-section">
  <div class="editorial-grid{% if section.settings.reverse %} editorial-grid--reverse{% endif %}">
    <div class="editorial-media">
      {% if editorial_image != blank %}{{ editorial_image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: editorial_image.alt | default: section.settings.heading | escape }}{% else %}<img src="{{ 'arrive-beach-editorial.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="lazy">{% endif %}
    </div>
    <div class="editorial-copy" data-reveal>
      {% if section.settings.subheading != blank %}<p class="eyebrow">{{ section.settings.subheading }}</p>{% endif %}
      <h2 class="serif-heading">{{ section.settings.heading }}</h2>
      {{ section.settings.text }}
      {% if section.settings.button_label != blank %}<p><a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a></p>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.editorial.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.all.image" },
    { "type": "checkbox", "id": "reverse", "label": "t:sections.all.reverse", "default": false },
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading", "default": "Island uniform" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Easy pieces, made for sunlit arrivals." },
    { "type": "richtext", "id": "text", "label": "t:sections.all.text", "default": "<p>Relaxed resortwear designed to move from salt water to late lunch, with color and texture drawn from Aruba.</p>" },
    { "type": "text", "id": "button_label", "label": "t:sections.all.button_label", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "t:sections.all.button_link" }
  ],
  "presets": [{ "name": "t:sections.editorial.name" }]
}
{% endschema %}
