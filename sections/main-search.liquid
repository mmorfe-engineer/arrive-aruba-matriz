<section class="aa-template aa-section">
  <div class="aa-shell">
    <div class="aa-products-head aa-reveal">
      <div>
        <p class="aa-kicker">Search</p>
        <h1 class="aa-title">Find your perfect fit</h1>
      </div>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="aa-form aa-reveal">
      <input class="aa-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <button class="aa-button" type="submit">{{ 'accessibility.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      <div class="aa-section">
        <div class="aa-products">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- else -%}
            <p>No results found.</p>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main search"
}
{% endschema %}
