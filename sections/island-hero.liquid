<section class="island-hero">
  {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt | default: section.settings.heading | escape }}{% else %}<img src="{{ 'arrive-island-banner.jpg' | asset_url }}" alt="" width="1920" height="1080" fetchpriority="high">{% endif %}
  <div class="island-hero-content page-width" data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 class="display-heading">{{ section.settings.heading }}</h1>{% if section.settings.text != blank %}<div class="island-intro">{{ section.settings.text }}</div>{% endif %}</div>
</section>
{% schema %}
{"name":"t:sections.island_hero.name","settings":[{"type":"image_picker","id":"image","label":"t:sections.all.image"},{"type":"text","id":"eyebrow","label":"t:sections.all.subheading","default":"The island"},{"type":"text","id":"heading","label":"t:sections.all.heading","default":"The island stays with you."},{"type":"richtext","id":"text","label":"t:sections.all.text","default":"<p>Not a souvenir. A feeling, carried forward.</p>"}],"presets":[{"name":"t:sections.island_hero.name"}]}
{% endschema %}
