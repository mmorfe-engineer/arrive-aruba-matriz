<section class="aa-section">
  <div class="aa-shell aa-products-head aa-reveal">
    <div>
      <p class="aa-kicker">{{ section.settings.kicker | escape }}</p>
      <h2 class="aa-title">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.collection != blank -%}
      <a class="aa-button aa-button--ghost" href="{{ section.settings.collection.url }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>

  <div class="aa-products aa-reveal">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.product_limit -%}
        {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..8) -%}
        <article class="aa-card">
          <div class="aa-card__media">{{ 'product-1' | placeholder_svg_tag }}</div>
          <div class="aa-card__info">
            <h3 class="aa-card__title">Arrive Aruba piece</h3>
            <div class="aa-card__price">$120.00</div>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Resortwear shaped by the island" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 4, "max": 20, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
