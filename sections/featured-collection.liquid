<section class="collection-section section-space">
  <div class="page-width">
    <div class="section-header" data-reveal>
      <div>{% if section.settings.subheading != blank %}<p class="eyebrow">{{ section.settings.subheading }}</p>{% endif %}<h2 class="serif-heading">{{ section.settings.heading | default: section.settings.collection.title }}</h2></div>
      {% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>{% endif %}
    </div>
    <div class="product-grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product, show_vendor: section.settings.show_vendor, show_wishlist: section.settings.show_wishlist %}{% endfor %}
      {% else %}
        {% for item in (1..4) %}
          <article class="product-card" data-reveal><div class="product-card-media"><span class="product-placeholder"><img src="{{ 'arrive-logo-mark.svg' | asset_url }}" alt="" width="420" height="420"></span></div><div class="product-card-info"><p class="product-card-vendor">Arrive Aruba</p><h3 class="product-card-title">Island piece {{ item }}</h3><div class="price"><span>{{ 12000 | money }}</span></div></div></article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "The first tide" },
    { "type": "collection", "id": "collection", "label": "t:sections.all.collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "default": 4, "label": "t:sections.all.products_to_show" },
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.featured_collection.show_vendor", "default": false },
    { "type": "checkbox", "id": "show_wishlist", "label": "t:sections.featured_collection.show_wishlist", "default": true }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
