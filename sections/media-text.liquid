<section class="aa-section">
  <div class="aa-shell aa-split {% if section.settings.reverse %}aa-split--reverse{% endif %}">
    <div class="aa-split__media aa-reveal">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '480, 760, 1100, 1500', sizes: '(min-width: 760px) 55vw, 100vw', alt: section.settings.heading }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="aa-reveal">
      <p class="aa-kicker">{{ section.settings.kicker | escape }}</p>
      <h2 class="aa-title">{{ section.settings.heading | escape }}</h2>
      <p class="aa-copy">{{ section.settings.text | escape }}</p>
      {%- if section.settings.button_label != blank -%}
        <p><a class="aa-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Media and text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout on desktop", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Aruba, remembered" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A souvenir without the noise" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Premium essentials designed to carry the atmosphere of the island into the everyday." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read the story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Media and text" }
  ]
}
{% endschema %}
