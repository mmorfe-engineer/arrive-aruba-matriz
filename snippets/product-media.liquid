{% doc %}
  Renders product media using its native Shopify media type.
  @param {media} media - Product media to render.
  @param {boolean} [eager] - Whether an image should load eagerly.
{% enddoc %}
{%- case media.media_type -%}
  {%- when 'image' -%}
    {%- assign media_loading = 'lazy' -%}
    {%- if eager -%}{%- assign media_loading = 'eager' -%}{%- endif -%}
    {{ media.preview_image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 750px) 50vw, 88vw', loading: media_loading, alt: media.alt | escape }}
  {%- when 'video' -%}
    {{ media | video_tag: controls: true, image_size: '1200x' }}
  {%- when 'external_video' -%}
    {{ media | external_video_tag }}
  {%- when 'model' -%}
    {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
{%- endcase -%}
