{% doc %}
@param {product} product - Product to render.
@param {boolean} [show_vendor] - Show vendor name.
@example
{% render 'product-card', product: product %}
{% enddoc %}

<article class="aa-card">
  <a class="aa-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260, 420, 620, 900', sizes: '(min-width: 1080px) 20vw, (min-width: 760px) 25vw, 50vw', alt: product.featured_image.alt | default: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>

  {%- unless product.available -%}
    <span class="aa-card__badge">{{ 'products.product.sold_out' | t }}</span>
  {%- endunless -%}

  <div class="aa-card__info">
    {%- if show_vendor and product.vendor != blank -%}
      <span class="aa-kicker">{{ product.vendor | escape }}</span>
    {%- endif -%}
    <h3 class="aa-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
    <div class="aa-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span>{{ product.price | money }}</span>
        <s>{{ product.compare_at_price | money }}</s>
      {%- else -%}
        <span>{{ product.price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</article>
