{% doc %}
  Renders a decorative, fixed SVG allowlist; unknown keys emit no markup.
  @param {string} [icon_key] - leaf, sun, shield, droplet, check or truck.
{% enddoc %}
{%- capture icon_path -%}
  {%- case icon_key -%}
    {%- when 'leaf' -%}<path d="M20 4C9 3 3 9 5 16c4 7 15 2 15-12ZM6 18 16 8M10 14v-4m0 4h4"/>
    {%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/>
    {%- when 'shield' -%}<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/>
    {%- when 'droplet' -%}<path d="M12 3s-7 8-7 12a7 7 0 0 0 14 0c0-4-7-12-7-12Z"/>
    {%- when 'check' -%}<path d="m5 12 4 4L19 6"/>
    {%- when 'truck' -%}<path d="M3 5h11v11H3V5Zm11 4h4l3 3v4h-7V9Z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
  {%- endcase -%}
{%- endcapture -%}
{%- if icon_path != blank -%}<svg class="product-feature-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ icon_path }}</svg>{%- endif -%}
