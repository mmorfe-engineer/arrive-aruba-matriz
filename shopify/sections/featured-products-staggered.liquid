{% comment %}
  ARRIVE ARUBA — Featured Products Staggered Grid
  Shopify OS 2.0 · Diseño escalonado para homepage
  Basado en el diseño original de Arrive Aruba - Homepage.dc.html
{% endcomment %}

{% assign products_to_show = section.settings.products_to_show | times: 1 %}
{% assign heading = section.settings.heading %}
{% assign eyebrow = section.settings.eyebrow %}

<style>
  .aa-staggered-wrap {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  .aa-staggered-header {
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  .aa-staggered-eyebrow {
    font-family: 'Geologica', sans-serif;
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 10px;
  }

  .aa-staggered-title {
    font-family: 'ITC Legacy Serif Std', 'Georgia', serif;
    font-weight: 400;
    font-size: clamp(30px, 7vw, 44px);
    color: {{ section.settings.text_color }};
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .aa-staggered-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    max-width: 640px;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .aa-staggered-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .aa-staggered-item:nth-child(2n) {
      margin-top: 0 !important;
    }
  }

  .aa-staggered-item {
    display: block;
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }

  /* Staggered effect: every 2nd item has top margin */
  .aa-staggered-item:nth-child(2n) {
    margin-top: 36px;
  }

  .aa-staggered-card {
    aspect-ratio: 3/4;
    position: relative;
    overflow: hidden;
    margin-bottom: 11px;
    background: #d8dfd2;
  }

  .aa-staggered-card__bg {
    position: absolute;
    inset: 0;
    background: {{ section.settings.card_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .aa-staggered-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(44, 79, 120, 0.5) 100%);
  }

  .aa-staggered-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .aa-staggered-card__brand-mark {
    width: 44%;
    opacity: 0.18;
    filter: brightness(0) invert(1);
  }

  .aa-staggered-card__category {
    position: absolute;
    bottom: 14px;
    left: 14px;
    font-family: 'Geologica', sans-serif;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240, 240, 229, 0.85);
  }

  .aa-staggered-info {
    margin-bottom: 3px;
  }

  .aa-staggered-info__title {
    font-family: 'Geologica', sans-serif;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 400;
    display: block;
  }

  .aa-staggered-info__price {
    font-family: 'Geologica', sans-serif;
    font-size: 10px;
    color: #aaa;
    font-weight: 300;
  }

  .aa-staggered-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(240, 240, 229, 0.92);
    font-family: 'Geologica', sans-serif;
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #386395;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .aa-save-button {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(240, 240, 229, 0.18);
    border: 1px solid rgba(240, 240, 229, 0.58);
    color: #F0F0E5;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .aa-save-button:hover {
    transform: translateY(-1px);
    background: rgba(240, 240, 229, 0.28);
    border-color: rgba(240, 240, 229, 0.86);
  }

  .aa-save-button.is-saved {
    background: #F0F0E5;
    color: #386395;
    border-color: #F0F0E5;
  }

  .aa-save-button svg {
    width: 16px;
    height: 16px;
    fill: transparent;
    transition: fill 0.2s ease;
  }

  .aa-save-button.is-saved svg {
    fill: currentColor;
  }

  .aa-view-all {
    display: inline-block;
    font-family: 'Geologica', sans-serif;
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #386395;
    border-bottom: 1px solid #386395;
    padding-bottom: 2px;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .aa-view-all:hover {
    opacity: 0.65;
  }

  .aa-staggered-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 38px;
  }
</style>

<div class="aa-staggered-wrap">
  <div class="aa-staggered-header">
    {% if eyebrow != blank %}
      <p class="aa-staggered-eyebrow">{{ eyebrow }}</p>
    {% endif %}
    {% if heading != blank %}
      <h2 class="aa-staggered-title">{{ heading }}</h2>
    {% endif %}
  </div>

  <div class="aa-staggered-grid" role="list">
    {% for product in section.settings.products %}
      {% assign product_item = product %}
      {% if forloop.index > products_to_show %}
        {% break %}
      {% endif %}
      
      <a href="{{ product_item.url }}" class="aa-staggered-item" role="listitem">
        <div class="aa-staggered-card">
          {% if product_item.featured_media %}
            {{ product_item.featured_media | image_url: width: 800 | image_tag:
              class: 'aa-staggered-card__image',
              loading: 'lazy',
              alt: product_item.featured_media.alt | escape,
              widths: '360, 540, 720, 800',
              sizes: '(max-width: 767px) 45vw, 25vw'
            }}
          {% else %}
            <div class="aa-staggered-card__bg">
              <img src="preview-assets/brand/logo-mark.svg" alt="" class="aa-staggered-card__brand-mark" />
            </div>
          {% endif %}
          
          <div class="aa-staggered-card__overlay"></div>
          
          {% if product_item.tags contains 'new' %}
            <span class="aa-staggered-badge">New</span>
          {% endif %}
          
          {% if section.settings.show_wishlist %}
            <button class="aa-save-button" 
                    type="button" 
                    aria-label="Save {{ product_item.title | escape }}"
                    data-product-id="{{ product_item.id }}"
                    data-product-title="{{ product_item.title | escape }}"
                    data-product-url="{{ product_item.url }}"
                    data-product-price="{{ product_item.price | money }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.6l-1-1a5.5 5.5 0 00-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 000-7.8z"/>
              </svg>
            </button>
          {% endif %}
          
          <p class="aa-staggered-card__category">{{ product_item.type | escape }}</p>
        </div>
        
        <div class="aa-staggered-info">
          <span class="aa-staggered-info__title">{{ product_item.title | escape }}</span>
          <p class="aa-staggered-info__price">
            {% if product_item.compare_at_price > product_item.price %}
              From {{ product_item.compare_at_price | money }}
            {% else %}
              From {{ product_item.price | money }}
            {% endif %}
          </p>
        </div>
      </a>
    {% endfor %}
  </div>

  {% if section.settings.show_view_all %}
    <div class="aa-staggered-header-row">
      <div></div>
      <a href="{{ section.settings.view_all_url }}" class="aa-view-all">{{ section.settings.view_all_text }}</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Featured Products - Staggered",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop the Island"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Select products",
      "limits": {
        "max": 8
      }
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": false
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link URL",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 16,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 16,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "label": "Header margin bottom",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F0F0E5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#23405e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#5F8BB8"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#5F8BB8"
    }
  ],
  "presets": [
    {
      "name": "Featured Products - Staggered",
      "category": "Products"
    }
  ]
}
{% endschema %}
