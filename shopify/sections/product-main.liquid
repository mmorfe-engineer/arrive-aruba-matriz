{% comment %}
  ARRIVE ARUBA — Product Main Section
  Shopify OS 2.0 · Editable via Theme Editor
{% endcomment %}

{% assign selected_or_first_available_variant = product.selected_or_first_available_variant %}
{% assign current_variant = selected_or_first_available_variant %}

<style>
  .aa-pdp {
    background: {{ section.settings.bg_color }};
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Media gallery */
  .aa-pdp__gallery {
    position: relative;
    overflow: hidden;
    background: #e8eef5;
  }
  @media (min-width: 900px) {
    .aa-pdp__gallery {
      width: 55%;
      position: sticky;
      top: 0;
      max-height: 100vh;
    }
  }
  .aa-pdp__gallery-main {
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    position: relative;
  }
  .aa-pdp__gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22,0.61,0.36,1);
  }
  .aa-pdp__gallery-thumbs {
    display: flex;
    gap: 8px;
    padding: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .aa-pdp__gallery-thumbs::-webkit-scrollbar { display: none; }
  .aa-pdp__gallery-thumb {
    flex-shrink: 0;
    width: 64px;
    height: 80px;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.18s ease;
  }
  .aa-pdp__gallery-thumb.active { border-color: #386395; }
  .aa-pdp__gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Desktop two-column */
  @media (min-width: 900px) {
    .aa-pdp__inner {
      display: flex;
      align-items: flex-start;
    }
    .aa-pdp__info {
      width: 45%;
      padding: 60px 48px 80px;
      position: relative;
    }
  }

  /* Info panel */
  .aa-pdp__info {
    padding: 28px 24px 140px;
  }
  .aa-pdp__eyebrow {
    font-family: 'Geologica', sans-serif;
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #5F8BB8;
    margin-bottom: 10px;
  }
  .aa-pdp__title {
    font-family: 'ITC Legacy Serif Std', 'Georgia', serif;
    font-size: clamp(26px, 4vw, 42px);
    font-weight: 500;
    color: #23405e;
    line-height: 1.12;
    margin-bottom: 16px;
  }
  .aa-pdp__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 6px;
  }
  .aa-pdp__price {
    font-family: 'Geologica', sans-serif;
    font-size: 22px;
    font-weight: 500;
    color: #386395;
  }
  .aa-pdp__compare {
    font-family: 'Geologica', sans-serif;
    font-size: 15px;
    font-weight: 300;
    color: #9fb0c4;
    text-decoration: line-through;
  }
  .aa-pdp__tax {
    font-family: 'Geologica', sans-serif;
    font-size: 11px;
    font-weight: 300;
    color: #9fb0c4;
    margin-bottom: 24px;
  }

  /* Variants */
  .aa-pdp__option-label {
    font-family: 'Geologica', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #23405e;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .aa-pdp__option-label span {
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0;
    text-transform: none;
    color: #5F8BB8;
    font-style: italic;
  }
  .aa-pdp__option-group {
    margin-bottom: 24px;
  }
  .aa-pdp__size-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .aa-pdp__size-chip {
    min-width: 52px;
    padding: 10px 14px;
    border-radius: 12px;
    font-family: 'Geologica', sans-serif;
    font-size: 13px;
    font-weight: 500;
    border: 1.5px solid rgba(56,99,149,0.22);
    background: #fff;
    color: #23405e;
    cursor: pointer;
    transition: all 0.18s ease;
    text-align: center;
  }
  .aa-pdp__size-chip:hover,
  .aa-pdp__size-chip.selected {
    background: #386395;
    color: #F0F0E5;
    border-color: #386395;
  }
  .aa-pdp__size-chip.unavailable {
    opacity: 0.35;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  /* Color swatches */
  .aa-pdp__color-swatches {
    display: flex;
    gap: 10px;
  }
  .aa-pdp__color-swatch {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    box-shadow: 0 0 0 1.5px rgba(0,0,0,0.1);
    transition: all 0.18s ease;
    appearance: none;
    -webkit-appearance: none;
    display: block;
  }
  .aa-pdp__color-swatch.selected {
    box-shadow: 0 0 0 3px #386395;
  }

  /* Add to cart */
  .aa-pdp__atc-wrap {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px 24px calc(16px + env(safe-area-inset-bottom, 0));
    background: linear-gradient(to top, rgba(240,240,229,1) 60%, rgba(240,240,229,0) 100%);
    z-index: 30;
  }
  @media (min-width: 900px) {
    .aa-pdp__atc-wrap {
      position: static;
      padding: 0;
      background: none;
      margin-top: 28px;
    }
  }
  .aa-pdp__atc {
    width: 100%;
    background: #386395;
    color: #F0F0E5;
    border: none;
    border-radius: 9999px;
    padding: 18px 24px;
    font-family: 'Geologica', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .aa-pdp__atc:hover { background: #2c4f78; }
  .aa-pdp__atc:active { transform: scale(0.98); }
  .aa-pdp__atc:disabled {
    background: #c4cfd8;
    cursor: not-allowed;
    transform: none;
  }

  /* Description */
  .aa-pdp__desc {
    font-family: 'Geologica', sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: #5c6d7e;
    line-height: 1.8;
    margin-bottom: 28px;
  }

  /* Delivery badge */
  .aa-pdp__delivery {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: #fff;
    border-radius: 14px;
    border: 1px solid rgba(56,99,149,0.1);
    margin-bottom: 28px;
  }
  .aa-pdp__delivery-text strong {
    font-family: 'Geologica', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #23405e;
    display: block;
    margin-bottom: 2px;
  }
  .aa-pdp__delivery-text small {
    font-family: 'Geologica', sans-serif;
    font-size: 11px;
    font-weight: 300;
    color: #9fb0c4;
  }

  /* Accordion */
  .aa-pdp__accordion {
    border-top: 1px solid rgba(56,99,149,0.12);
  }
  .aa-pdp__accordion-item {
    border-bottom: 1px solid rgba(56,99,149,0.12);
  }
  .aa-pdp__accordion-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    background: none;
    border: none;
    font-family: 'Geologica', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #23405e;
    cursor: pointer;
    text-align: left;
  }
  .aa-pdp__accordion-btn svg {
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }
  .aa-pdp__accordion-btn[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .aa-pdp__accordion-body {
    display: none;
    padding: 0 0 20px;
    font-family: 'Geologica', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: #5c6d7e;
    line-height: 1.75;
  }
  .aa-pdp__accordion-body.open { display: block; }

  /* Error */
  .aa-pdp__error {
    font-family: 'Geologica', sans-serif;
    font-size: 12px;
    color: #F5A169;
    font-weight: 300;
    text-align: center;
    margin-top: 10px;
    display: none;
  }
</style>

<div class="aa-pdp" itemscope itemtype="https://schema.org/Product">
  <div class="aa-pdp__inner">

    <!-- Gallery -->
    <div class="aa-pdp__gallery">
      <div class="aa-pdp__gallery-main" id="aa-pdp-main-img">
        {% if product.featured_media %}
          {{ product.featured_media | image_url: width: 1200 | image_tag:
            id: 'aa-pdp-active-img',
            loading: 'eager',
            alt: product.featured_media.alt | escape,
            widths: '480, 720, 900, 1200',
            sizes: '(max-width: 900px) 100vw, 55vw',
            itemprop: 'image'
          }}
        {% else %}
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#dceaf4;">
            <span style="font-size:80px;opacity:0.12;">✦</span>
          </div>
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="aa-pdp__gallery-thumbs" role="list" aria-label="Product images">
          {% for media in product.media %}
            <button class="aa-pdp__gallery-thumb {% if forloop.first %}active{% endif %}"
              data-media-id="{{ media.id }}"
              data-src="{{ media | image_url: width: 900 }}"
              aria-label="Image {{ forloop.index }}"
              role="listitem">
              {{ media | image_url: width: 160 | image_tag:
                loading: 'lazy',
                alt: media.alt | escape,
                widths: '80, 120, 160'
              }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Info -->
    <div class="aa-pdp__info">
      <p class="aa-pdp__eyebrow" itemprop="category">
        {% if product.type != blank %}{{ product.type }} · {% endif %}Arrive Aruba ✦
      </p>
      <h1 class="aa-pdp__title" itemprop="name">{{ product.title }}</h1>

      <div class="aa-pdp__price-row" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
        <meta itemprop="price" content="{{ current_variant.price | divided_by: 100.0 }}">
        <meta itemprop="availability" content="{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">
        <span class="aa-pdp__price">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="aa-pdp__compare">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>
      {% if cart.taxes_included %}
        <p class="aa-pdp__tax">Tax included.</p>
      {% else %}
        <p class="aa-pdp__tax">Tax calculated at checkout.</p>
      {% endif %}

      {%- form 'product', product, id: 'aa-pdp-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="aa-variant-id">

        {% for option in product.options_with_values %}
          <div class="aa-pdp__option-group">
            <p class="aa-pdp__option-label">
              {{ option.name }}
              <span id="aa-selected-{{ option.position }}">{{ current_variant.options[forloop.index0] }}</span>
            </p>

            {% if option.name == 'Color' or option.name == 'Colour' %}
              <div class="aa-pdp__color-swatches">
                {% for value in option.values %}
                  {% assign is_selected = false %}
                  {% if current_variant.options[forloop.index0] == value %}
                    {% assign is_selected = true %}
                  {% endif %}
                  <button type="button"
                    class="aa-pdp__color-swatch {% if is_selected %}selected{% endif %}"
                    data-option-position="{{ option.position }}"
                    data-value="{{ value | escape }}"
                    style="background-color: {{ value | downcase | replace: ' ', '' }};"
                    title="{{ value | escape }}">
                  </button>
                {% endfor %}
              </div>

            {% else %}
              <div class="aa-pdp__size-chips">
                {% for value in option.values %}
                  {% assign is_selected = false %}
                  {% if current_variant.options[forloop.index0] == value %}
                    {% assign is_selected = true %}
                  {% endif %}
                  <button type="button"
                    class="aa-pdp__size-chip {% if is_selected %}selected{% endif %}"
                    data-option-position="{{ option.position }}"
                    data-value="{{ value | escape }}">
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}

        {% if section.settings.show_description %}
          <div class="aa-pdp__desc" itemprop="description">{{ product.description }}</div>
        {% endif %}

        {% if section.settings.show_delivery_badge %}
          <div class="aa-pdp__delivery">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#92AF88" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <div class="aa-pdp__delivery-text">
              <strong>{{ section.settings.delivery_title }}</strong>
              <small>{{ section.settings.delivery_subtitle }}</small>
            </div>
          </div>
        {% endif %}

        <div class="aa-pdp__atc-wrap">
          <button type="submit"
            name="add"
            class="aa-pdp__atc"
            id="aa-atc-btn"
            {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}
              {{ section.settings.atc_label | default: 'Add to Bag' }}
            {% else %}
              Sold Out
            {% endif %}
          </button>
          <p class="aa-pdp__error" id="aa-pdp-error">Please select all options before adding to bag.</p>
        </div>

      {%- endform -%}

      <!-- Accordion blocks -->
      {% if section.blocks.size > 0 %}
        <div class="aa-pdp__accordion">
          {% for block in section.blocks %}
            {% if block.type == 'accordion' %}
              <div class="aa-pdp__accordion-item" {{ block.shopify_attributes }}>
                <button class="aa-pdp__accordion-btn" aria-expanded="false" aria-controls="aa-acc-{{ block.id }}">
                  {{ block.settings.title }}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5F8BB8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="aa-pdp__accordion-body" id="aa-acc-{{ block.id }}" role="region">
                  {{ block.settings.content }}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>
</div>

<script>
(function() {
  // Accordion
  document.querySelectorAll('.aa-pdp__accordion-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', !expanded);
      var body = document.getElementById(this.getAttribute('aria-controls'));
      body && body.classList.toggle('open', !expanded);
    });
  });

  // Variant selection
  var variantData = {{ product.variants | json }};
  var selectedOptions = [
    {{ current_variant.option1 | json }},
    {{ current_variant.option2 | json }},
    {{ current_variant.option3 | json }}
  ];

  function updateVariant() {
    var match = null;
    for (var i = 0; i < variantData.length; i++) {
      var v = variantData[i];
      if (v.option1 === selectedOptions[0] &&
          (v.option2 === selectedOptions[1] || !v.option2) &&
          (v.option3 === selectedOptions[2] || !v.option3)) {
        match = v;
        break;
      }
    }
    if (!match) return;

    document.getElementById('aa-variant-id').value = match.id;
    var atc = document.getElementById('aa-atc-btn');
    if (atc) {
      atc.disabled = !match.available;
      atc.textContent = match.available
        ? (atc.dataset.label || 'Add to Bag')
        : 'Sold Out';
    }

    // Update URL
    history.replaceState(null, '', '?variant=' + match.id);
  }

  document.querySelectorAll('.aa-pdp__size-chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      var pos = parseInt(this.dataset.optionPosition) - 1;
      selectedOptions[pos] = this.dataset.value;

      // Update active state
      var siblings = document.querySelectorAll('.aa-pdp__size-chip[data-option-position="' + this.dataset.optionPosition + '"]');
      siblings.forEach(function(s) { s.classList.remove('selected'); });
      this.classList.add('selected');

      // Update label
      var label = document.getElementById('aa-selected-' + this.dataset.optionPosition);
      if (label) label.textContent = this.dataset.value;

      updateVariant();
    });
  });

  document.querySelectorAll('.aa-pdp__color-swatch').forEach(function(swatch) {
    swatch.addEventListener('click', function() {
      var pos = parseInt(this.dataset.optionPosition) - 1;
      selectedOptions[pos] = this.dataset.value;

      var siblings = document.querySelectorAll('.aa-pdp__color-swatch[data-option-position="' + this.dataset.optionPosition + '"]');
      siblings.forEach(function(s) { s.classList.remove('selected'); });
      this.classList.add('selected');

      var label = document.getElementById('aa-selected-' + this.dataset.optionPosition);
      if (label) label.textContent = this.dataset.value;

      updateVariant();
    });
  });

  // Gallery thumbnails
  document.querySelectorAll('.aa-pdp__gallery-thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      var src = this.dataset.src;
      var img = document.getElementById('aa-pdp-active-img');
      if (img && src) img.src = src;
      document.querySelectorAll('.aa-pdp__gallery-thumb').forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product main",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 900,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "3/4", "label": "Portrait 3:4" },
        { "value": "1/1", "label": "Square 1:1" },
        { "value": "4/5", "label": "Portrait 4:5" }
      ],
      "default": "3/4"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description",
      "default": true
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to bag button label",
      "default": "Add to Bag"
    },
    {
      "type": "header",
      "content": "Delivery badge"
    },
    {
      "type": "checkbox",
      "id": "show_delivery_badge",
      "label": "Show delivery badge",
      "default": true
    },
    {
      "type": "text",
      "id": "delivery_title",
      "label": "Delivery title",
      "default": "Delivered in 24 hours across Aruba"
    },
    {
      "type": "text",
      "id": "delivery_subtitle",
      "label": "Delivery subtitle",
      "default": "Free on orders over $150 · Island ease guaranteed"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F0F0E5"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your product details here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product main",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Description" } },
        { "type": "accordion", "settings": { "title": "Size & Fit" } },
        { "type": "accordion", "settings": { "title": "Delivery" } },
        { "type": "accordion", "settings": { "title": "Returns" } }
      ]
    }
  ]
}
{% endschema %}
