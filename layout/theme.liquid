<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_star_sapphire | default: '#386395' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}
    <style>
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_serif | font_face: font_display: 'swap' }}

      :root {
        --aa-star: {{ settings.color_star_sapphire | default: '#386395' }};
        --aa-silver: {{ settings.color_silver_lake | default: '#5F8BB8' }};
        --aa-green: {{ settings.color_fair_green | default: '#92AF88' }};
        --aa-orange: {{ settings.color_mock_orange | default: '#F5A169' }};
        --aa-cream: {{ settings.color_cannoli_cream | default: '#F0F0E5' }};
        --aa-ink: {{ settings.color_ink | default: '#111512' }};
        --aa-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --aa-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --aa-serif: {{ settings.font_serif.family }}, {{ settings.font_serif.fallback_families }};
      }
    </style>
    {{ 'arrive-aruba.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'arrive-aruba.js' | asset_url }}" defer></script>
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" class="site-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
